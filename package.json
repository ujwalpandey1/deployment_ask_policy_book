{
  "name": "policy-atlas",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Evidence-first, access-aware policy intelligence for OP-05",
  "engines": { "node": ">=22.14.0" },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "dev": "node --env-file-if-exists=.env --watch src/server.js",
    "test": "node --test tests/*.test.js",
    "test:e2e": "playwright test",
    "test:e2e:live": "playwright test --config=playwright.live.config.js",
    "test:paraphrases": "node --env-file-if-exists=.env scripts/test-paraphrases.js",
    "test:container": "node scripts/container-smoke.js",
    "test:all": "npm test && npm run test:e2e",
    "evaluate": "node --env-file-if-exists=.env scripts/evaluate.js",
    "benchmark": "node --env-file-if-exists=.env scripts/benchmark.js",
    "rehearse": "node scripts/freshness.js",
    "verify:data": "node scripts/import-corpus.js --verify"
  },
  "devDependencies": { "@playwright/test": "1.63.0" }
}

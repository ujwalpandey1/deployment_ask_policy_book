# No credentials are needed for extractive mode. Copy to .env to configure.
PORT=4600
HOST=127.0.0.1
CORPUS_DIR=vendor/op05/corpus
DATA_DIR=runtime
# auto chooses model only when LLM_API_KEY or OPENAI_API_KEY is present.
GENERATION_MODE=auto
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4.1-mini-2025-04-14
LLM_API_KEY=
# auto enables embeddings with the existing key in model mode. No second key.
# off keeps the older keyword-only search (also used by the offline preview).
SEMANTIC_SEARCH=auto
# Optional persistent cache location; default is DATA_DIR/semantic.
# SEMANTIC_CACHE_DIR=runtime/semantic
LLM_TIMEOUT_MS=9000
MAX_CONTEXT_CHARS=3600
# Conservative extract-only preview; lexical coverage is not semantic confidence.
MIN_EXTRACTIVE_COVERAGE=0.55
MAX_OUTPUT_TOKENS=650
MAX_CONCURRENCY=12
# demo trusts request roles and must bind to loopback. runner authenticates
# one trusted gateway; tokens binds each caller credential to one role.
AUTH_MODE=demo
RUNNER_TOKEN=
# JSON object mapping credentials to public / ops / legal; keep secret.
AUTH_TOKENS={}
# Enables authenticated reload of CORPUS_DIR. Empty disables the endpoint.
ADMIN_TOKEN=
# Grader configuration, separate from generation.
JUDGE_MODEL=gpt-4.1-mini-2025-04-14
